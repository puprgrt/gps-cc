# ============================================================
# GPS-CC Environment Variables
# Garut Public Service AI Command Center
# ============================================================
# Salin file ini menjadi .env dan isi nilai-nilainya.
# JANGAN commit file .env ke repository!
# ============================================================

# --- PURI Multi-Modal AI Orchestrator 2026 ---
# 1. ChatGPT Free Tier (GPT-5.6 Terra / GPT-4o-mini compatible)
OPENAI_API_KEY=your_openai_api_key_here

# 2. Google Gemini 3.5 (Flash / Pro - Large Context & Vision)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Anthropic Claude (Claude 3.5 Sonnet - Legal & Compliance Analysis)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 4. Moonshot Kimi (Kimi v1 - Coding, IFC/BIM Parser, GIS Spatial)
MOONSHOT_API_KEY=your_moonshot_api_key_here

# 5. Local AI Cluster (Ollama / vLLM Open Weight - 100% Uptime Offline Fallback)
LOCAL_AI_URL=http://localhost:11434/api/generate
LOCAL_AI_MODEL=qwen2.5:7b-instruct

# --- Firebase (Client-Side: prefix NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIRESTORE_DATABASE_ID=your_firestore_database_id

# --- Baileys WhatsApp Server ---
BAILEYS_PORT=3001
BAILEYS_SESSION_PATH=./baileys_auth_garut
